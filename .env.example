# Application Environment
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL with pg_trgm extension)
# Note: For production, use SSL and strong credentials
DATABASE_URL=postgresql://vrm_app:CHANGE_ME_TO_STRONG_PASSWORD@localhost:5432/vrm
DB_APP_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

# Authentication & Session Security (Min 32 characters for HMAC SHA-256)
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_ADMIN_PASSWORD

# Security & CORS
CORS_ORIGIN=http://localhost:5173
# Reverse proxy hops: Set to false (default) or number of hops (e.g. 1 for Render/Railway/Nginx)
TRUST_PROXY=false

# External Surveillance Sources
# OpenFDA API key (optional for low-volume; get key from https://open.fda.gov)
OPENFDA_API_KEY=
INGEST_CRON=0 */6 * * *
NEWS_ENABLED=false

# Email Notification Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
