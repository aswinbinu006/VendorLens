# Backend Application Environment
NODE_ENV=production
PORT=4000

# Database Connection (PostgreSQL with pg_trgm extension)
DATABASE_URL=postgresql://vrm_app:CHANGE_ME_TO_STRONG_PASSWORD@localhost:5432/vrm
DB_APP_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

# Authentication & Session Security (Min 32 characters for HMAC SHA-256)
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_ADMIN_PASSWORD

# Security & CORS
# In production, set to your deployed frontend origin (e.g. https://your-vrm-frontend.vercel.app)
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# External Surveillance Sources
OPENFDA_API_KEY=
INGEST_CRON=0 */6 * * *
NEWS_ENABLED=false

# Email Notification Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
