{
  "name": "ai-vendor-risk-monitor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vrm/api",
    "dev:backend": "npm run dev --workspace=@vrm/api",
    "dev:frontend": "npm run dev --workspace=@vrm/web",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=@vrm/api",
    "build:frontend": "npm run build --workspace=@vrm/web",
    "start:backend": "npm run start --workspace=@vrm/api",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm run lint --workspace=@vrm/api",
    "lint:frontend": "npm run lint --workspace=@vrm/web",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "npm run typecheck --workspace=@vrm/api",
    "typecheck:frontend": "npm run typecheck --workspace=@vrm/web",
    "test": "npm run test --workspace=@vrm/api",
    "test:backend": "npm run test --workspace=@vrm/api",
    "db:generate": "npm run prisma:generate --workspace=@vrm/api",
    "db:migrate": "npm run prisma:migrate --workspace=@vrm/api",
    "match:report": "npm run match:report --workspace=@vrm/api",
    "demo:candidates": "npm run demo:candidates --workspace=@vrm/api",
    "proof": "npm run proof --workspace=@vrm/api",
    "check:secrets": "node apps/api/scripts/secret-scan.js"
  }
}
