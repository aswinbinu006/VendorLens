# 1. Environment and Secret Files (NEVER COMMIT CREDENTIALS)
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*

# 2. Dependencies
node_modules/
.pnp
.pnp.js
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]

# 3. Build & Compilation Outputs
dist/
build/
out/
.next/
.nuxt/
.turbo/
*.tsbuildinfo
.tsbuildinfo

# 4. Logs and Diagnostic Outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Coverage Artifacts
coverage/
.nyc_output/
.vitest/

